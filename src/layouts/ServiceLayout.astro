---
import Layout from './Layout.astro';
import type { Service } from '../data/services';
import { services } from '../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
const site = Astro.site ?? new URL('https://www.prophotogr.com');
const pageUrl = new URL(`/services/${service.slug}/`, site).toString();

const title = `${service.titleGr} | Pro Photo GR — Αθήνα`;
const description = service.summary;
const ogImage = service.cover;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Αρχική', item: site.origin + '/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: site.origin + '/#services' },
    { '@type': 'ListItem', position: 3, name: service.titleGr, item: pageUrl },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.titleGr,
  alternateName: service.titleEn,
  description: service.summary,
  serviceType: service.titleEn,
  provider: { '@id': `${site.origin}/#business` },
  areaServed: [
    { '@type': 'City', name: 'Athens' },
    { '@type': 'Country', name: 'Greece' },
  ],
  url: pageUrl,
  image: new URL(service.cover, site).toString(),
};

const otherServices = services.filter((s) => s.slug !== service.slug);
---
<Layout title={title} description={description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} slot="head" />

  <a href="/" class="fixed top-[15px] left-[15px] z-[200] inline-flex items-center gap-2 text-white text-[12px] uppercase tracking-wide font-bold bg-black/60 px-3 py-2 rounded backdrop-blur-sm hover:bg-black/80 transition md:top-[25px] md:left-[25px]" aria-label="Πίσω στην αρχική σελίδα">← Αρχική</a>

  <main class="bg-black text-white min-h-screen pt-[80px] pb-[80px] md:pt-[120px]">
    <article class="max-w-[1200px] mx-auto px-[20px] md:px-[40px]">
      <nav aria-label="Breadcrumb" class="text-[11px] uppercase tracking-wide text-[#9a9a9a] mb-6">
        <ol class="flex flex-wrap gap-2">
          <li><a href="/" class="hover:text-white transition">Αρχική</a></li>
          <li>/</li>
          <li><a href="/#services" class="hover:text-white transition">Services</a></li>
          <li>/</li>
          <li class="text-white">{service.titleGr}</li>
        </ol>
      </nav>

      <header class="mb-12 max-w-3xl">
        <h1 class="font-oswald text-[32px] md:text-[48px] lg:text-[60px] font-bold uppercase leading-[1.05] tracking-wide mb-6">
          {service.titleGr}
        </h1>
        <p class="text-[15px] md:text-[17px] leading-relaxed text-[#cfcfcf] mb-4">
          {service.summary}
        </p>
        {service.body.map((p) => (
          <p class="text-[14px] md:text-[16px] leading-relaxed text-[#a8a8a8] mb-4">{p}</p>
        ))}
      </header>

      <section class="mb-16" aria-labelledby="includes-heading">
        <h2 id="includes-heading" class="font-oswald text-[20px] md:text-[24px] uppercase tracking-wide mb-4 spacer-line-vertical-light pb-4">
          Τι περιλαμβάνει
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 max-w-2xl">
          {service.includes.map((item) => (
            <li class="text-[14px] md:text-[15px] text-[#cfcfcf] flex items-start gap-2">
              <span class="text-white mt-1" aria-hidden="true">→</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mb-16" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading" class="font-oswald text-[20px] md:text-[24px] uppercase tracking-wide mb-6 spacer-line-vertical-light pb-4">
          Gallery — {service.titleEn}
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          {service.gallery.map((src, i) => (
            <a
              href={src}
              class="block aspect-[4/5] overflow-hidden bg-[#111] group"
              data-gallery={`service-${service.slug}`}
              aria-label={`Άνοιγμα φωτογραφίας ${i + 1} από ${service.titleGr}`}
            >
              <img
                src={src}
                alt={`${service.titleGr} — Pro Photo GR Αθήνα — εικόνα ${i + 1}`}
                width="600"
                height="750"
                loading={i < 4 ? 'eager' : 'lazy'}
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </a>
          ))}
        </div>
      </section>

      <section class="mb-16 border border-[#222] p-6 md:p-10 text-center" aria-labelledby="cta-heading">
        <h2 id="cta-heading" class="font-oswald text-[24px] md:text-[32px] uppercase tracking-wide mb-4">
          Έτοιμοι για shoot;
        </h2>
        <p class="text-[14px] md:text-[16px] text-[#cfcfcf] mb-6 max-w-xl mx-auto">
          Στείλτε ένα μήνυμα για να συζητήσουμε το project σας. Απαντάμε εντός 24 ωρών.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="mailto:Prophotogr5@gmail.com" class="inline-block px-6 py-3 bg-white text-black uppercase tracking-wide text-[12px] font-bold hover:bg-[#cfcfcf] transition">
            Email Prophotogr5@gmail.com
          </a>
          <a href="tel:+306940115915" class="inline-block px-6 py-3 border border-white text-white uppercase tracking-wide text-[12px] font-bold hover:bg-white hover:text-black transition">
            Τηλέφωνο 6940 115 915
          </a>
        </div>
      </section>

      <section aria-labelledby="other-services-heading">
        <h2 id="other-services-heading" class="font-oswald text-[20px] md:text-[24px] uppercase tracking-wide mb-6 spacer-line-vertical-light pb-4">
          Άλλες υπηρεσίες
        </h2>
        <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
          {otherServices.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class="block group">
                <div class="aspect-square overflow-hidden bg-[#111] mb-2">
                  <img
                    src={s.cover}
                    alt={`Cover για ${s.titleGr} — Pro Photo GR`}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                </div>
                <span class="block text-[12px] md:text-[13px] uppercase tracking-wide font-bold group-hover:text-[#cfcfcf] transition">
                  {s.titleGr}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </article>
  </main>
</Layout>
