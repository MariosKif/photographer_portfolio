---
<div class="section relative overflow-hidden bg-black" id="works">
  <div class="section-title-vertical right-side"><span>Works</span></div>

  <div class="relative w-full h-screen !p-0 !m-0">
    <div class="swiper works-swiper w-full h-full">
      <div class="swiper-wrapper">
        {worksItems.map((item) => (
          <div class="swiper-slide">
            <div
              class="works-page-img-carousel-item relative w-full h-full bg-cover bg-center bg-no-repeat overlay overlay-inverse-dark-35"
              style={`background-image: url('${item.image}')`}
            >
              <img
                src={item.image}
                alt={`${item.title.replace(/<br\s*\/?>/g, ' ')} φωτογράφιση — Pro Photo GR Αθήνα`}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
                class="sr-only"
              />
              <div class="works-page-img-carousel-wrapper relative bg-transparent h-full">
                <div class="works-page-img-carousel-text absolute w-full text-center text-white text-[14px] font-medium tracking-wide bottom-[50px] px-[20px] z-10 md:px-[40px] lg:px-[60px] lg:text-[13px]">
                  <div class="works-page-img-carousel-title">
                    <h3 class="font-oswald text-[18px] font-normal uppercase tracking-wide text-white leading-[1.25] pb-[8px] -mb-[5px] [text-shadow:1px_1px_2px_#111] lg:text-[25px] lg:leading-[1.5] lg:pb-[3px] lg:mb-0" set:html={item.title}></h3>
                  </div>
                  <div class="works-page-img-carousel-content">
                    <div class="mt-[26px]"></div>
                    <a
                      class={`c-btn inverse ${item.type === 'photo' ? 'popup-photo' : ''}`}
                      href={item.href}
                      title={item.title.replace(/<br\s*\/?>/g, ' ')}
                      data-gallery={item.gallery || undefined}
                      data-gallery-extra={item.galleryImages && item.galleryImages.length > 1 ? JSON.stringify(item.galleryImages.slice(1)) : undefined}
                    ><span>{item.label}</span></a>
                    {item.gallery && (
                      <div class="mt-[14px]">
                        <a
                          href={`/services/${item.gallery === 'couple' ? 'couple-photography' : item.gallery}/`}
                          class="inline-block text-white text-[11px] uppercase tracking-wide font-bold underline underline-offset-4 hover:opacity-70 transition-opacity"
                          aria-label={`Full gallery for ${item.title.replace(/<br\s*\/?>/g, ' ')}`}
                        >Full gallery →</a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</div>
